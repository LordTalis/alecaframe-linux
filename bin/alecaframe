#!/bin/bash
# alecaframe - run Overwolf + AlecaFrame alongside Warframe on Linux (umu-launcher + Proton).
#
# Part of alecaframe-linux: https://github.com/LordTalis/alecaframe-linux  (MIT)
# Approach and Overwolf-config findings from Deftera186's guide (gist b589b9147694484e772ab7e164402d20); see CREDITS.md.
#
# Order of operations (matters!):
#   1. alecaframe warframe   -> starts the Warframe LAUNCHER (not the game) and prepares AlecaFrame
#   2. wait for "READY"       (or: alecaframe status)
#   3. press Play in the launcher, log in in-game
#   4. alecaframe check-data -> confirms Overwolf's data scanner attached to the game
#
# Commands: warframe | prepare | reattach | unfreeze | stop | status | check-data | logs | profile | doctor | install-kwin-rules | install-launcher

set -u

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/alecaframe-linux"
CONF="${ALECA_CONF:-$CONF_DIR/profile.conf}"

# ---- profile defaults (install.sh writes the real values into $CONF) ----
WINEPREFIX=""                  # the Proton prefix that holds Overwolf + AlecaFrame
GAME_DIR=""                    # directory that contains Public/ (Warframe's DownloadDir)
LAUNCHER_EXE=""                # auto-resolved when empty (see resolve_launcher)
GAMEID="umu-warframe"
STORE="none"
PROTONPATH="UMU-Proton-10.0-4-netfix"
AF_EXTID="afmcagbpgggkpdkokjhjkllpegnadmkignlonpjm"
OOPO_MODE="on"                 # on = live data on DXVK (overlay injects, renderer detected); off = stale data
NEUTER_REMOTE_DISABLE="0"      # 1 = rewrite Overwolf's overlay_disabled_games.json entry for Warframe (normally unnecessary)
OVERLAY_KILL_WHEN_LOADED="1"   # once the scanner has attached, kill Overwolf's overlay process (it can freeze game input)
OVERLAY_KILL_MAX="1"           # ...at most this many times per scanner session. Overwolf relaunches the overlay after a kill;
                               # killing it again and again (3x in 5 s on 2026-10-27) makes Overwolf decide the GAME quit:
                               # it closes the data feed and its client spins at 70% CPU (AlecaFrame window frozen). 0 = never kill.
REATTACH_AFTER="75"            # seconds of game uptime without the scanner before the watchdog restarts Overwolf (once)
GIVEUP_AFTER="900"             # seconds AFTER LOGIN (EE.log "Logged in") without captured data before the watchdog kills the
                               # overlay and stops. Counted from login since 2026-11-05: the inventory only arrives after
                               # login/loading screens, and a 7-minute login made the old game-start clock give up first.
TRIM_MEMORY="1"                # 1 = keep Overwolf under its 900 MiB self-restart ("Time for a break") by reclaiming cold pages
TRIM_ABOVE_MB="750"            # trim when the Overwolf client's resident memory is above this
TRIM_TO_MB="550"               # ...aiming for about this
CLIPKEEP="1"                   # 1 = run clipkeep.exe next to the game: when another program in the game's Wine session
                               # (Overwolf) takes focus for a split second, Wine drops the game's mouse lock and Warframe
                               # does not lock it again, so the pointer slides to the other monitor mid-mission. clipkeep
                               # puts the game's own lock back after such a blip; Esc and Alt-Tab still free the mouse.
CLIPKEEP_EXE="${XDG_DATA_HOME:-$HOME/.local/share}/alecaframe-linux/clipkeep.exe"   # built from tools/clipkeep.c
INJECT_MODE="umu"              # umu = re-enter the umu-run container; steam = Valve launcher service (experimental)
STEAM_APPID="230410"
SLR_LAUNCH_CLIENT=""
LOGDIR="$CONF_DIR/logs"
# --------------------------------------------------------------------------
[ -f "$CONF" ] && . "$CONF"
mkdir -p "$LOGDIR"

PFX_USER="$WINEPREFIX/drive_c/users/steamuser"
OW_DIR="$WINEPREFIX/drive_c/Program Files (x86)/Overwolf"
OW_LAUNCHER="$OW_DIR/OverwolfLauncher.exe"
OW_APPDATA="$PFX_USER/AppData/Local/Overwolf"
AF_BGLOG="$OW_APPDATA/Log/Apps/AlecaFrame/BackGround.html.log"
GEP_LOG="$OW_APPDATA/Log/Apps/Overwolf General GameEvents Provider/index.html.log"
LOG="$LOGDIR/overwolf-launch.log"
REAPER_PIDFILE="$LOGDIR/overlay-reaper.pid"
WF_GAMEID=89541
WF_CLASSID=8954
AF_DATA_CDN="https://cdn.alecaframe.com/warframeData"

# Common umu knobs; MUST be identical for the launcher and the injection or umu won't re-enter the container.
# PROTON_USE_XALIA=0: Proton's accessibility helper is a Mono app and errors once real .NET 4.8 is in the prefix.
# UMU_CONTAINER_NSENTER=1 on EVERY launch: umu only starts the container's launcher service (the endpoint 'prepare'
#   re-enters through) when this is set on the first launch too. A first launch logs "Failed to find bus name"
#   five times (5 s) and then starts normally; harmless.
UMU_ENV=(WINEPREFIX="$WINEPREFIX" GAMEID="$GAMEID" STORE="$STORE" PROTONPATH="$PROTONPATH" SteamDeck=0 PROTON_USE_XALIA=0 UMU_CONTAINER_NSENTER=1)

need_profile() {
    if [ -z "$WINEPREFIX" ] || [ -z "$GAME_DIR" ]; then
        echo "No profile. Run install.sh, or create $CONF with WINEPREFIX and GAME_DIR." >&2; exit 2
    fi
}
resolve_launcher() {
    # On its first run the standalone launcher moves itself from <GAME_DIR>/Public/Tools into the prefix's AppData
    # (registry LauncherExe). Prefer that copy once it exists.
    [ -n "$LAUNCHER_EXE" ] && { printf '%s\n' "$LAUNCHER_EXE"; return; }
    local a="$PFX_USER/AppData/Local/Warframe/Downloaded/Public/Tools/Launcher.exe"
    [ -f "$a" ] && { printf '%s\n' "$a"; return; }
    printf '%s\n' "$GAME_DIR/Public/Tools/Launcher.exe"
}

# ---------- detection helpers (ps + comm, never pgrep -f: patterns must not match our own command line) ----------
launcher_container_up() {
    if [ "$INJECT_MODE" = "steam" ]; then
        ps -eo args 2>/dev/null | grep -E 'Launcher\.exe.*-registry:Steam' | grep -qv grep
    else
        ps -eo args 2>/dev/null | grep -E 'umu-run.*Launcher\.exe' | grep -qv grep
    fi
}
# umu's own state: it installs/updates its Steam Linux Runtime (steamrt3 for Proton 10) on the FIRST launch while holding
# umu.lock, REPLACING the runtime directory. An inject during that window dies in pressure-vessel ("Cannot create
# temporary directory .../steamrt3/var/tmp-*") and Overwolf never starts. Re-entry also needs the container's launcher
# service to own its session-bus name (com.steampowered.App<md5>). Both are checked before every inject.
UMU_LOCAL="${UMU_FOLDERS_PATH:+$UMU_FOLDERS_PATH/umu}"; UMU_LOCAL="${UMU_LOCAL:-${XDG_DATA_HOME:-$HOME/.local/share}/umu}"
UMU_RUNTIME="${UMU_RUNTIME:-steamrt3}"
umu_container_ready() {
    [ "$INJECT_MODE" = "steam" ] && return 0
    [ -f "$UMU_LOCAL/$UMU_RUNTIME/.installed.ok" ] || return 1
    if command -v flock >/dev/null; then flock -n "$UMU_LOCAL/umu.lock" true 2>/dev/null || return 1; fi
    command -v busctl >/dev/null || return 0
    busctl --user list --acquired --no-pager 2>/dev/null | grep -qE '^com\.steampowered\.App[0-9a-f]{32} '
}
wait_for_container() {   # wait (default 600 s) until the container is ready; explains itself after 10 s, then every minute
    local secs="${1:-600}" i=0
    while [ "$i" -lt "$secs" ]; do
        umu_container_ready && return 0
        if [ "$i" -eq 10 ] || { [ "$i" -gt 10 ] && [ $((i % 60)) -eq 0 ]; }; then
            echo "$(date +%H:%M:%S) umu is still installing/updating its runtime, or the launcher's container is not up yet; waiting (${i}s)..."
        fi
        i=$((i+2)); sleep 2
    done
    echo "$(date +%H:%M:%S) the launcher's container never became ready in ${secs}s (umu runtime update stuck?). See $LOG"
    return 1
}
ATTACH_FILE="$LOGDIR/attach-epoch"   # written at every Overwolf (re)launch; the reaper ignores provider sessions older than it
mark_attach() { date +%s > "$ATTACH_FILE" 2>/dev/null || true; }
attach_epoch() { cat "$ATTACH_FILE" 2>/dev/null || echo 0; }
reaper_alive() {   # a live reaper process; a zombie (parent never waited) still answers kill -0, so read its state
    local p s; p=$(cat "$REAPER_PIDFILE" 2>/dev/null); [ -n "$p" ] || return 1
    s=$(awk '{print $3}' /proc/"$p"/stat 2>/dev/null); [ -n "$s" ] && [ "$s" != "Z" ]
}
pv_errors() {   # count of pressure-vessel "Cannot create temporary directory" failures in the launch log so far
    local n; n=$(grep -c 'Cannot create temporary directory' "$LOG" 2>/dev/null); echo "${n:-0}"
}
game_running()     { ps -eo comm 2>/dev/null | grep -q '^Warframe.x64'; }
overwolf_running() { ps -eo comm 2>/dev/null | grep -q -i '^OverwolfBrowser'; }
game_age() {   # seconds since Warframe.x64.exe started (0 if not running)
    local p; p=$(ps -eo pid,comm | awk '$2 ~ /^Warframe.x64/ {print $1; exit}'); [ -n "$p" ] || { echo 0; return; }
    ps -o etimes= -p "$p" 2>/dev/null | tr -d ' '
}

# ---------- GamesList OOPO (loads Overwolf's data scanner under DXVK) ----------
gameslist_files() {
    for d in "$OW_APPDATA" "$OW_DIR"/*/Resources; do
        [ -d "$d" ] || continue
        for f in "$d"/GamesList*.xml; do [ -f "$f" ] && printf '%s\n' "$f"; done
    done
}
oopo_present_in() {
    awk '/<GameInfo>/ { blk=""; isWF=0 } { blk=blk $0 ORS } /<ID>'"$WF_GAMEID"'<\/ID>/ { isWF=1 }
         /<\/GameInfo>/ { if (isWF && blk ~ /<OOPO>True<\/OOPO>/) found=1 } END { exit(found?0:1) }' "$1" 2>/dev/null
}
add_oopo() {
    local GL="$1"
    cp -f "$GL" "$GL.bak.$(date +%Y%m%d-%H%M%S)" 2>/dev/null
    awk '/<GameInfo>/ { isWF=0 } /<ID>'"$WF_GAMEID"'<\/ID>/ { isWF=1 }
         (isWF && /<\/GameInfo>/ && !done) { print "    <OOPO>True</OOPO>"; done=1; isWF=0 } { print }' "$GL" > "$GL.tmp" && mv "$GL.tmp" "$GL"
}
remove_oopo() {
    local GL="$1"
    cp -f "$GL" "$GL.bak.$(date +%Y%m%d-%H%M%S)" 2>/dev/null
    awk '/<GameInfo>/ { isWF=0 } /<ID>'"$WF_GAMEID"'<\/ID>/ { isWF=1 } /<\/GameInfo>/ { isWF=0 }
         (isWF && /<OOPO>.*<\/OOPO>/) { next } { print }' "$GL" > "$GL.tmp" && mv "$GL.tmp" "$GL"
}
apply_oopo_mode() {
    gameslist_files | while IFS= read -r GL; do
        if [ "$OOPO_MODE" = "on" ]; then
            oopo_present_in "$GL" && continue
            add_oopo "$GL" && oopo_present_in "$GL" && echo "  (set <OOPO>True</OOPO> for Warframe in $(basename "$GL"))"
        else
            oopo_present_in "$GL" || continue
            remove_oopo "$GL" && echo "  (removed <OOPO> for Warframe from $(basename "$GL"))"
        fi
    done
}
# Overwolf fetches a newer GamesList.<version>.xml from its CDN every week or two, usually right after it starts, and the
# fresh copy replaces the one we patched. Without OOPO the provider waits for a renderer DXVK never reports (no data) and
# the overlay runs INSIDE the game (Wine stub aborts every frame: stutter, frozen input). So check the list Overwolf
# actually loads (highest version), after it has started, not only before.
newest_gameslist() {
    local f v best="" bestv=-1
    for f in "$OW_APPDATA"/GamesList.*.xml; do
        [ -f "$f" ] || continue
        v=${f##*/GamesList.}; v=${v%.xml}
        case "$v" in ''|*[!0-9]*) continue ;; esac
        [ "$v" -gt "$bestv" ] && { bestv=$v; best=$f; }
    done
    [ -n "$best" ] && printf '%s\n' "$best"
}
oopo_ok() {   # true when the games list Overwolf will load has OOPO for Warframe (always true with OOPO_MODE=off)
    [ "$OOPO_MODE" = "on" ] || return 0
    local gl; gl=$(newest_gameslist)
    if [ -n "$gl" ]; then oopo_present_in "$gl"; return; fi
    gameslist_files | { local n=0; while IFS= read -r gl; do oopo_present_in "$gl" || exit 1; n=$((n+1)); done; [ "$n" -gt 0 ]; }
}

# ---------- per-game overlay ON (required: the first overlay frame is what detects the renderer -> loads the scanner) ----------
OW_GAME_SETTINGS_DB="$OW_APPDATA/Settings/game_settings.db"
ensure_overlay_on() {
    [ -d "$OW_GAME_SETTINGS_DB" ] || return 0
    overwolf_running && return 0     # never edit a live LevelDB
    python3 - "$OW_GAME_SETTINGS_DB" "$WF_CLASSID" <<'PYEOF'
"""Enable Overwolf's per-game overlay for one game class in Settings/game_settings.db.

game_settings.db is a LevelDB directory. Instead of shipping a LevelDB library this appends a single
write-batch record to the current .log file; LevelDB replays the log when Overwolf next opens the database
and the record with the highest sequence number wins. Format reference: leveldb/doc/log_format.md and
db/write_batch.cc in google/leveldb. Only run this while Overwolf is not running.
Exit codes: 0 = record appended, 1 = overlay already enabled, 2 = setting not found / unexpected layout.
"""
import datetime, glob, os, re, shutil, struct, sys

BLOCK_SIZE = 32 * 1024
HEADER_SIZE = 7                        # crc32c (4) + payload length (2) + fragment kind (1)
FULL, FIRST, MIDDLE, LAST = 1, 2, 3, 4  # fragment kinds
PUT = 1                                # write-batch entry kind for an insert/update

def _build_crc_table(poly=0x82F63B78):
    table = []
    for byte in range(256):
        crc = byte
        for _ in range(8):
            crc = (crc >> 1) ^ poly if crc & 1 else crc >> 1
        table.append(crc)
    return table

CRC_TABLE = _build_crc_table()

def crc32c(buf):
    crc = 0xFFFFFFFF
    for b in buf:
        crc = CRC_TABLE[(crc ^ b) & 0xFF] ^ (crc >> 8)
    return crc ^ 0xFFFFFFFF

def masked_crc(buf):
    """LevelDB stores the checksum rotated right by 15 bits plus a constant (util/crc32c.h, Mask())."""
    crc = crc32c(buf)
    return (((crc >> 15) | (crc << 17)) + 0xA282EAD8) & 0xFFFFFFFF

def put_varint(n):
    out = bytearray()
    while n >= 0x80:
        out.append((n & 0x7F) | 0x80)
        n >>= 7
    out.append(n)
    return bytes(out)

def get_varint(buf, pos):
    result = shift = 0
    while True:
        b = buf[pos]
        pos += 1
        result |= (b & 0x7F) << shift
        if b < 0x80:
            return result, pos
        shift += 7

def log_records(blob):
    """Yield the payload of each complete logical record in a LevelDB log file."""
    pos, pending = 0, bytearray()
    while pos + HEADER_SIZE <= len(blob):
        room = BLOCK_SIZE - pos % BLOCK_SIZE
        if room < HEADER_SIZE:                      # block trailer: nothing fits, move to the next block
            pos += room
            continue
        _crc, length, kind = struct.unpack_from('<IHB', blob, pos)
        pos += HEADER_SIZE
        if length == 0 and kind == 0:               # zero padding: skip the rest of the block
            if pos % BLOCK_SIZE:
                pos += BLOCK_SIZE - pos % BLOCK_SIZE
            continue
        fragment = blob[pos:pos + length]
        pos += length
        if kind == FULL:
            yield bytes(fragment)
        elif kind == FIRST:
            pending = bytearray(fragment)
        elif kind == MIDDLE:
            pending += fragment
        elif kind == LAST:
            pending += fragment
            yield bytes(pending)
            pending = bytearray()

def decode_batch(payload):
    """Return (sequence, count, [(key, value or None), ...]) for one write-batch payload."""
    sequence, count = struct.unpack_from('<QI', payload, 0)
    pos, entries = 12, []
    for _ in range(count):
        kind = payload[pos]
        pos += 1
        klen, pos = get_varint(payload, pos)
        key = payload[pos:pos + klen]
        pos += klen
        value = None
        if kind == PUT:
            vlen, pos = get_varint(payload, pos)
            value = payload[pos:pos + vlen]
            pos += vlen
        entries.append((key, value))
    return sequence, count, entries

def encode_put_batch(sequence, key, value):
    return (struct.pack('<QI', sequence, 1) + bytes([PUT])
            + put_varint(len(key)) + key + put_varint(len(value)) + value)

def frame_record(payload, file_size):
    """Split one logical record into physical fragments for a log file that is currently file_size long."""
    out, rest, first = bytearray(), memoryview(payload), True
    while True:
        room = BLOCK_SIZE - (file_size + len(out)) % BLOCK_SIZE
        if room < HEADER_SIZE:                      # pad the block trailer with zeros
            out += b'\0' * room
            continue
        piece = bytes(rest[:room - HEADER_SIZE])
        rest = rest[len(piece):]
        done = len(rest) == 0
        kind = FULL if first and done else FIRST if first else LAST if done else MIDDLE
        out += struct.pack('<IHB', masked_crc(bytes([kind]) + piece), len(piece), kind) + piece
        first = False
        if done:
            return bytes(out)

def main(db_dir, class_id):
    logs = glob.glob(os.path.join(db_dir, '*.log'))
    if len(logs) != 1:
        return 2
    log_path = logs[0]
    with open(log_path, 'rb') as fh:
        blob = fh.read()
    last_sequence, found = 0, None
    for payload in log_records(blob):
        try:
            sequence, count, entries = decode_batch(payload)
        except (struct.error, IndexError):
            continue
        if count:
            last_sequence = max(last_sequence, sequence + count - 1)
        for key, value in entries:
            if value is not None and class_id in key and b'overlayDisabled' in value:
                found = (key, value)
    if found is None:
        return 2
    key, value = found
    text = value.decode('latin-1').rstrip()
    if '"overlayDisabled":false' in text and '"overlayDisabledModifiedByUser":true' in text:
        return 1
    text = re.sub(r'"overlayDisabled":(?:true|false)', '"overlayDisabled":false', text)
    text = re.sub(r'"overlayDisabledModifiedByUser":(?:true|false)', '"overlayDisabledModifiedByUser":true', text)
    shutil.copytree(db_dir, '%s.bak.%s' % (db_dir, datetime.datetime.now().strftime('%Y%m%d-%H%M%S')))
    record = frame_record(encode_put_batch(last_sequence + 1, bytes(key), text.encode('latin-1')), len(blob))
    with open(log_path, 'ab') as fh:
        fh.write(record)
    return 0

if __name__ == '__main__':
    sys.exit(main(sys.argv[1], sys.argv[2].encode()))
PYEOF
    case $? in
        0) echo "  (enabled the Overwolf overlay for Warframe - required for live data)";;
        2) echo "  (overlay setting for Warframe not present yet; toggle it ON once in Overwolf settings if data stays stale)";;
    esac
}

# ---------- remote overlay-disable list: report only (opt-in rewrite) ----------
check_overlay_not_remotely_disabled() {
    local DGJ="$OW_APPDATA/PackagesCache/overlay_disabled_games.json"
    [ -f "$DGJ" ] || return 0
    python3 - "$DGJ" "$WF_GAMEID" "$NEUTER_REMOTE_DISABLE" <<'PYEOF'
"""Report (or, with NEUTER_REMOTE_DISABLE=1, override) Overwolf's remote overlay-disable list for Warframe."""
import json, sys
path, game_id, override = sys.argv[1], int(sys.argv[2]), sys.argv[3] == "1"
try:
    with open(path, encoding="utf-8") as fh:
        doc = json.load(fh)
    entries = [e for e in doc.get("games", []) if isinstance(e, dict) and e.get("id") == game_id]
except (OSError, ValueError, AttributeError):
    sys.exit(0)
if not entries:
    sys.exit(0)
if override:
    for entry in entries:
        entry["minVersion"] = "999.0.0.0"          # a version Overwolf will never reach: the entry never applies
    with open(path, "w", encoding="utf-8") as fh:
        json.dump(doc, fh)
    print("  (NEUTER_REMOTE_DISABLE=1: rewrote Overwolf's remote overlay-disable entry for Warframe)")
else:
    print("  WARNING: Overwolf's remote list currently disables the Warframe overlay: %s" % entries)
    print("           Live data will not work until Overwolf lifts it. (NEUTER_REMOTE_DISABLE=1 overrides it locally.)")
PYEOF
}

# ---------- AlecaFrame manifest: clickable MainWindow under XWayland + remembered position ----------
ensure_manifest_patches() {
    local EXTROOT="$OW_APPDATA/Extensions/$AF_EXTID"
    [ -d "$EXTROOT" ] || return 0
    for MF in "$EXTROOT"/*/manifest.json; do
        [ -f "$MF" ] || continue
        python3 - "$MF" <<'PYEOF'
"""Make AlecaFrame's main window a normal, clickable window that keeps its position (Overwolf manifest.json)."""
import datetime, json, os, shutil, sys
path = sys.argv[1]
WANTED = {"native_window": False, "keep_window_location": True}
try:
    with open(path, encoding="utf-8") as fh:
        manifest = json.load(fh)
    window = manifest["data"]["windows"]["MainWindow"]
except (OSError, ValueError, KeyError, TypeError):
    sys.exit(2)
if not isinstance(window, dict):
    sys.exit(2)
if all(window.get(k) is v for k, v in WANTED.items()):
    sys.exit(1)
shutil.copyfile(path, "%s.bak.%s" % (path, datetime.datetime.now().strftime("%Y%m%d-%H%M%S")))
window.update(WANTED)
tmp = path + ".tmp"
with open(tmp, "w", encoding="utf-8") as fh:
    json.dump(manifest, fh, indent=2)
os.replace(tmp, path)
sys.exit(0)
PYEOF
        [ $? -eq 0 ] && echo "  (patched AlecaFrame MainWindow manifest: clickable under XWayland, keeps its position)"
    done
}

# ---------- AlecaFrame data cache (a missing json.7z hangs its init under Wine TLS) ----------
ensure_data_cache() {
    local CD="$PFX_USER/AppData/Local/AlecaFrame/cachedData" want cur rmd5 tmp got
    mkdir -p "$CD"
    want=""; [ -f "$CD/receivedMD5.txt" ] && want=$(awk '{print $1; exit}' "$CD/receivedMD5.txt" 2>/dev/null)
    cur="";  [ -f "$CD/json.7z" ] && cur=$(md5sum "$CD/json.7z" | awk '{print $1}')
    [ -n "$cur" ] && [ -n "$want" ] && [ "$cur" = "$want" ] && return 0
    rmd5=$(curl -fsSL "$AF_DATA_CDN/json7z.md5" 2>/dev/null | awk '{print $1; exit}')
    [ -n "$rmd5" ] || return 0
    if [ -n "$cur" ] && [ "$cur" = "$rmd5" ]; then printf '%s  json.7z\n' "$rmd5" > "$CD/receivedMD5.txt"; return 0; fi
    echo "  (refreshing AlecaFrame data cache json.7z from the CDN so init will not hang...)"
    tmp="$CD/json.7z.dl"
    curl -fsSL "$AF_DATA_CDN/json.7z" -o "$tmp" 2>/dev/null
    got=$(md5sum "$tmp" 2>/dev/null | awk '{print $1}')
    if [ -n "$got" ] && [ "$got" = "$rmd5" ]; then
        mv -f "$tmp" "$CD/json.7z"; printf '%s  json.7z\n' "$rmd5" > "$CD/receivedMD5.txt"; echo "  (data cache ready: $rmd5)"
    else
        rm -f "$tmp"; echo "  (WARN: could not refresh json.7z; if AlecaFrame hangs at startup, that is why)"
    fi
}

# ---------- data scanner state ----------
gep_loaded() {   # scanner attached in the CURRENT provider session (each start logs "Game Service Initialized")
    [ -f "$GEP_LOG" ] || return 1
    # Overwolf does not reset this log when it restarts: a session that predates our last launch is the previous run
    [ "$(gep_session_start)" -ge "$(attach_epoch)" ] || return 1
    awk '/Game Service Initialized|==== *new session/ { buf=""; next } { buf=buf $0 ORS }
         END { if (buf ~ /Warframe plugin loaded:.*success/ || buf ~ /detected renderer: D3D/) exit 0; else exit 1 }' "$GEP_LOG" 2>/dev/null
}
gep_oopo_off() {   # the CURRENT provider session sees the game WITHOUT out-of-process overlay: the scanner can never attach
    [ -f "$GEP_LOG" ] || return 1
    awk '/Game Service Initialized|==== *new session/ { buf=""; next } { buf=buf $0 ORS }
         END { if (buf ~ /"oopOverlay":false|is oop overlay false|Waiting for renderer\.\./) exit 0; else exit 1 }' "$GEP_LOG" 2>/dev/null
}
gep_written_since() {   # provider log written at/after epoch $1 (so it belongs to this game run, not an earlier one)
    [ "$(stat -c %Y "$GEP_LOG" 2>/dev/null || echo 0)" -ge "$1" ]
}
gep_session_start() {   # epoch of the current provider session (timestamp on the first line of its log), 0 if unknown
    local t; t=$(head -c 64 "$GEP_LOG" 2>/dev/null | tr -d '\r\357\273\277' | cut -c1-19)
    [ -n "$t" ] && date -d "$t" +%s 2>/dev/null || echo 0
}
inventory_ready() {   # true once AlecaFrame has captured the inventory this session. A large account's inventory can
    local logs        # take much longer to scan than the GEP session takes to start, so this gates the overlay kill:
    logs=$(ls -t "$(dirname "$AF_BGLOG")"/BackGround.html*.log 2>/dev/null | head -2)   # killing the overlay before
    [ -n "$logs" ] || return 1                                                          # capture makes Overwolf drop
    grep -a -q 'New inventory data' $logs 2>/dev/null                                   # the game and lose the data.
}
RIG_EE_LOG="$PFX_USER/AppData/Local/Warframe/EE.log"
since_login() {   # seconds since the player logged in during THIS game run (EE.log "Logged in" line), -1 before login.
    # EE.log lines start with seconds since the game process started, so login age = game age - that offset.
    local age off
    age=$(game_age); [ "${age:-0}" -gt 0 ] 2>/dev/null || { echo -1; return; }
    # an EE.log not written since the game started belongs to an earlier run
    [ "$(stat -c %Y "$RIG_EE_LOG" 2>/dev/null || echo 0)" -ge $(( $(date +%s) - age )) ] || { echo -1; return; }
    off=$(tr -d '\r' < "$RIG_EE_LOG" 2>/dev/null | grep -a -m1 -E '^[0-9]+\.[0-9]+ Sys \[Info\]: Logged in ' | cut -d. -f1)
    [ -n "$off" ] || { echo -1; return; }
    echo $(( age - off ))
}

# ---------- memory trim: the Linux stand-in for Windows' EmptyWorkingSet ----------
# Overwolf restarts itself ("Time for a break", OverWolf.Client.BL MemoryTracker) once its private working set reaches
# 900 MiB, even mid-game, and re-injects into the game when it comes back. On Windows it stays below that by calling
# EmptyWorkingSet at 500 MiB; Wine implements EmptyWorkingSet as a no-op, so here the number only grows (about 32 MB
# a minute while the killed overlay leaves Overwolf leaking a thread every 5 s). Overwolf's reading is its resident
# memory, so: put the Overwolf processes in their own systemd scope the moment they start, and have the watchdog ask
# the kernel to reclaim that scope's cold pages. Memory stays charged to the cgroup it was allocated in, which is why
# adoption has to happen at startup, and why the tool never reclaims from any cgroup it did not create (the game's).
OW_SCOPE_FILE="$LOGDIR/overwolf-scope"
TRIM_LOCK="$LOGDIR/trim.pid"
ow_client_pid() { ps -eo pid,comm 2>/dev/null | awk '$2 ~ /^(OverwolfLaunche|Overwolf\.exe)/ {print $1; exit}'; }
adopt_overwolf() {   # background, ~60 s: move each new Overwolf client process into one transient user scope
    [ "$TRIM_MEMORY" = "1" ] && command -v busctl >/dev/null || return 0
    local unit; unit="alecaframe-overwolf-$(date +%s).scope"
    echo "$unit" > "$OW_SCOPE_FILE"
    (
        declare -A seen; local p created=0 end=$(( $(date +%s) + 60 ))
        for p in $(ps -eo pid,comm | awk '$2 ~ /^(OverwolfLaunche|Overwolf\.exe)/ {print $1}'); do seen[$p]=1; done
        while [ "$(date +%s)" -lt "$end" ]; do
            for p in $(ps -eo pid,comm | awk '$2 ~ /^(OverwolfLaunche|Overwolf\.exe)/ {print $1}'); do
                [ -n "${seen[$p]:-}" ] && continue; seen[$p]=1
                if [ "$created" -eq 0 ]; then
                    busctl --user call org.freedesktop.systemd1 /org/freedesktop/systemd1 org.freedesktop.systemd1.Manager \
                        StartTransientUnit 'ssa(sv)a(sa(sv))' "$unit" fail 2 PIDs au 1 "$p" Slice s app.slice 0 >/dev/null 2>&1 && created=1
                else
                    busctl --user call org.freedesktop.systemd1 /org/freedesktop/systemd1 org.freedesktop.systemd1.Manager \
                        AttachProcessesToUnit 'ssau' "$unit" / 1 "$p" >/dev/null 2>&1
                fi
            done
            sleep 0.1
        done
        [ "$created" -eq 1 ] && echo "$(date +%H:%M:%S) Overwolf adopted into $unit (memory trim armed)"
    ) </dev/null >>"$LOG" 2>&1 &
}
trim_overwolf() {   # reclaim cold pages from Overwolf's own scope when the client nears Overwolf's 900 MiB limit
    [ "$TRIM_MEMORY" = "1" ] || return 0
    local p cg rss amt
    p=$(ow_client_pid); [ -n "$p" ] || return 0
    cg="/sys/fs/cgroup$(cut -d: -f3 "/proc/$p/cgroup" 2>/dev/null)"
    case "$cg" in */alecaframe-overwolf-*.scope) ;; *) return 0 ;; esac
    [ -w "$cg/memory.reclaim" ] || return 0
    rss=$(( $(ps -o rss= -p "$p" 2>/dev/null || echo 0) / 1024 ))
    [ "$rss" -gt "$TRIM_ABOVE_MB" ] || return 0
    [ -f "$TRIM_LOCK" ] && kill -0 "$(cat "$TRIM_LOCK" 2>/dev/null)" 2>/dev/null && return 0
    amt=$(( (rss - TRIM_TO_MB) * 3 )); [ "$amt" -gt 2048 ] && amt=2048   # scope-wide reclaim; ~1/3 lands on the client
    (
        echo "$BASHPID" > "$TRIM_LOCK"
        echo "${amt}M" > "$cg/memory.reclaim" 2>/dev/null
        echo "$(date +%H:%M:%S) trimmed Overwolf: client ${rss} MB -> $(( $(ps -o rss= -p "$p" 2>/dev/null || echo 0) / 1024 )) MB (asked ${amt} MB of its scope)"
        rm -f "$TRIM_LOCK"
    ) </dev/null >>"$LOG" 2>&1 &
}

# ---------- injection into the running launcher container ----------
inject() {
    mark_attach
    if [ "$INJECT_MODE" = "steam" ]; then
        local exe="$1"; shift
        setsid nohup "$SLR_LAUNCH_CLIENT" --bus-name="com.steampowered.App$STEAM_APPID" --directory="$(dirname "$exe")" \
            -- wine "$exe" "$@" </dev/null >>"$LOG" 2>&1 &
    else
        setsid nohup env "${UMU_ENV[@]}" PROTON_VERB=runinprefix UMU_RUNTIME_UPDATE=0 \
            umu-run "$@" </dev/null >>"$LOG" 2>&1 &
    fi
}

# ---------- mouse-lock keeper (tools/clipkeep.c) ----------
clipkeep_running() { ps -eo comm 2>/dev/null | grep -qx 'clipkeep.exe'; }
start_clipkeep() {   # into the running container, like inject(), but WITHOUT mark_attach (it is not an Overwolf attach)
    [ "$CLIPKEEP" = "1" ] && [ "$INJECT_MODE" = "umu" ] && [ -f "$CLIPKEEP_EXE" ] || return 0
    clipkeep_running && return 0
    local wlog="Z:$(printf '%s' "$LOGDIR/clipkeep.log" | tr '/' '\\')"
    echo "$(date +%H:%M:%S) starting clipkeep (keeps the game's mouse lock through focus blips; log: $LOGDIR/clipkeep.log)" >> "$LOG"
    setsid nohup env "${UMU_ENV[@]}" PROTON_VERB=runinprefix UMU_RUNTIME_UPDATE=0 \
        umu-run "$CLIPKEEP_EXE" "$wlog" </dev/null >>"$LOG" 2>&1 &
}
stop_clipkeep() { pkill -x clipkeep.exe 2>/dev/null || true; }

# ---------- Wine X11 driver registry keys (user.reg) ----------
# Wine reads user.reg only when its wineserver starts and REWRITES the file when it exits, so the keys are checked right
# before a launch and only while no wineserver runs for the prefix. Space-separated Name=Value pairs; "" = disabled.
#   UseTakeFocus=N  (2026-11-07) KWin 6.7.5 mishandles Wine's WM_TAKE_FOCUS ("Globally Active") windows (KDE bug 525590,
#                   fixed in KWin 6.7.6): X focus flips to another window for ~30 ms, Wine's server drops the game's cursor
#                   clip on every foreground change, and the pointer slides onto the second monitor. Without WM_TAKE_FOCUS
#                   KWin uses its normal focus path. GrabFullscreen=Y is deliberately NOT set (it would trap the mouse in
#                   menus; the user wants Esc to free it).
X11_DRIVER_KEYS="UseTakeFocus=N"
prefix_wineserver_running() { pgrep -af wineserver 2>/dev/null | grep -qF -- "$WINEPREFIX"; }
ensure_x11_driver_keys() {
    [ -n "$X11_DRIVER_KEYS" ] && [ -f "$WINEPREFIX/user.reg" ] || return 0
    local i; for i in $(seq 1 20); do prefix_wineserver_running || break; sleep 1; done
    if prefix_wineserver_running; then
        echo "[alecaframe] a wineserver is still running for $WINEPREFIX: registry keys ($X11_DRIVER_KEYS) not checked" >&2; return 0
    fi
    python3 - "$WINEPREFIX/user.reg" $X11_DRIVER_KEYS <<'PYEOF'
import os, sys, time, shutil
reg, pairs = sys.argv[1], [a.split("=", 1) for a in sys.argv[2:]]
SECTION = "[Software\\\\Wine\\\\X11 Driver]"
text = open(reg, encoding="utf-8", errors="surrogateescape").read()
lines = text.split("\n")
start = next((i for i, l in enumerate(lines) if l.startswith(SECTION + " ") or l == SECTION), None)
if start is None:
    while lines and lines[-1] == "": lines.pop()
    t = time.time()
    block = [f"{SECTION} {int(t)}", "#time=" + format(int((t + 11644473600) * 10_000_000), "x")] + [f'"{k}"="{v}"' for k, v in pairs]
    new = "\n".join(lines + [""] + block + ["", ""])
else:
    end = start + 1
    while end < len(lines) and not lines[end].startswith("["): end += 1
    last = end == len(lines)
    body = lines[start:end]
    while body and body[-1] == "": body.pop()
    kept = [l for l in body if not any(l.startswith(f'"{k}"=') for k, _ in pairs)] + [f'"{k}"="{v}"' for k, v in pairs]
    new = "\n".join(lines[:start] + kept + (["", ""] if last else [""]) + lines[end:])
if new != text:
    bak = f"{reg}.bak-{time.strftime('%Y%m%d')}-x11keys"
    if not os.path.exists(bak): shutil.copy2(reg, bak)
    tmp = reg + ".tmp-x11keys"
    with open(tmp, "w", encoding="utf-8", errors="surrogateescape") as f: f.write(new)
    os.replace(tmp, reg)
    print(f"[alecaframe] user.reg: set X11 Driver {' '.join(sys.argv[2:])} (backup {os.path.basename(bak)})")
PYEOF
}

# ---------- overlay containment ----------
contain_overlay_windows() {
    command -v xdotool >/dev/null || return 0
    local w
    for w in $(xdotool search --name '^ow overlay$' 2>/dev/null) $(xdotool search --name '^Overwolf Quick Launcher$' 2>/dev/null); do
        xdotool windowminimize "$w" 2>/dev/null
    done
}
kill_overlays() {   # the overlay process is only needed until the scanner has attached; afterwards it can hog CPU and
    local p n=0 why="${1:-scanner already attached}"   # install a global input hook that freezes the game's controls.
    for p in $(ps -eo pid,comm | awk '$2 ~ /^ow-overlay/ {print $1}'); do      # Data keeps flowing after killing it.
        kill -TERM "$p" 2>/dev/null && { n=$((n+1)); echo "$(date +%H:%M:%S) killed ow-overlay pid=$p ($why)" >> "$LOG"; }
    done
    [ "$n" -gt 0 ]   # true when something was killed (the reaper counts kill rounds per scanner session)
}
ow_trace_log() { ls -t "$OW_APPDATA"/Log/Trace_*.log 2>/dev/null | head -1; }
ow_thinks_game_quit() {   # Overwolf's current trace says the game's last state is Quit while Warframe.x64.exe is alive.
    # Seen 2026-10-27: after the overlay process was killed 3x in 5 s, OverlayService logged "Process exit: Warframe.x64.exe"
    # for the live game -> GamesManager State: Quit -> events provider closed ("No game for 10 seconds") -> no live data
    # for the rest of the run, and the Overwolf client spun at ~70% CPU (AlecaFrame window unresponsive).
    game_running || return 1
    local t; t=$(ow_trace_log); [ -n "$t" ] || return 1
    [ "$(grep -a 'Process state changed invoked on game: Warframe' "$t" 2>/dev/null | tail -1 | grep -o 'State: [A-Za-z]*')" = "State: Quit" ]
}
ow_client_cpu() {   # the Overwolf client's CPU use since it started, in percent (ps average; a healthy idle client is <10)
    local p; p=$(ow_client_pid); [ -n "$p" ] && ps -o pcpu= -p "$p" 2>/dev/null | tr -d ' ' || echo 0
}
reap_dead_overlays() {
    # NOTE: Overwolf's --game-pid is a *Windows* PID and cannot be checked against Linux /proc.
    game_running && return 0
    local p
    for p in $(ps -eo pid,comm | awk '$2 ~ /^ow-overlay/ {print $1}'); do
        kill -TERM "$p" 2>/dev/null && echo "$(date +%H:%M:%S) reaped ow-overlay pid=$p (game not running)" >> "$LOG"
    done
}
overlay_reaper_loop() {
    # Per game run: at most ONE re-attach, then give up. Every re-attach injects Overwolf into the live game again; on
    # 2026-10-18 the second one in a session killed it (exit 0xC0000409), so never loop on it.
    local misses=0 tick=0 reattached=0 gave_up=0 age started scan_t0 scanning att stale_gep kills=0 kill_sess=0 quit_warned=0 sl cap_logged=0 ck_starts=0
    while :; do
        reap_dead_overlays
        contain_overlay_windows
        tick=$((tick+1))
        [ $((tick % 15)) -eq 0 ] && trim_overwolf
        game_running || { reattached=0; gave_up=0; kills=0; kill_sess=0; quit_warned=0; cap_logged=0; ck_starts=0; }
        # mouse-lock keeper: start it once the game runs (at most twice per run in case it dies; it exits by itself
        # 2 min after the game is gone)
        if [ $((tick % 5)) -eq 0 ] && [ "$ck_starts" -lt 2 ] && game_running && ! clipkeep_running; then
            start_clipkeep; ck_starts=$((ck_starts+1))
        fi
        if [ $((tick % 10)) -eq 0 ] && [ "$quit_warned" -eq 0 ] && ow_thinks_game_quit; then
            # Overwolf dropped the live game (overlay kill misread as the game exiting): the feed is closed for this run
            # and its client may spin. Nothing to re-inject here (the game is fine); tell the user once and leave it.
            echo "$(date +%H:%M:%S) Overwolf logged the game as QUIT while Warframe.x64.exe is running (overlay kill misdetect): live data is over for this run; Overwolf client at $(ow_client_cpu)% CPU" >> "$LOG"
            notify_fail "Overwolf thinks the game has quit, so live data stopped for this run (your inventory captured earlier is kept). If the AlecaFrame window hangs: 'alecaframe stop' (the game is left alone), and set OVERLAY_KILL_MAX=0 in the profile."
            quit_warned=1
        fi
        if [ $((tick % 2)) -eq 0 ] && [ "$gave_up" -eq 0 ] && game_running; then
            age=$(game_age); started=$(( $(date +%s) - age ))
            # scanning time = seconds since the CURRENT provider session started (a re-attach restarts the scan, so the
            # give-up clock restarts with it). On 2026-10-22 a re-attach 6 min into the game was "given up" after 20 s
            # because the clock counted from game start: the overlay was killed mid-scan and no inventory was captured.
            scan_t0=$(gep_session_start); att=$(attach_epoch)
            if [ "$att" -gt "$scan_t0" ]; then
                # Overwolf was (re)launched after the provider session in the log: that log is the PREVIOUS session. Nothing
                # it says (loaded, oopo off, age) applies yet; wait for the new provider to write. (2026-10-22: a reattach
                # was "given up" 2 s in, reading the old session.)
                scanning=0; stale_gep=1
            else
                stale_gep=0; [ "$scan_t0" -gt "$started" ] && scanning=$(( $(date +%s) - scan_t0 )) || scanning=$age
            fi
            if [ "$stale_gep" -eq 1 ]; then
                :   # provider not up yet for this attach
            elif [ "$OOPO_MODE" = "on" ] && gep_written_since "$started" && gep_oopo_off; then
                # Overwolf loaded a games list without OOPO: no data this run, the overlay runs inside the game and
                # stutters/freezes it, and re-injecting can crash it. Stopping Overwolf is safe for the game; patch the
                # list for the next launch and tell the user instead of re-attaching.
                echo "$(date +%H:%M:%S) provider sees the game WITHOUT OOPO (games list lost the patch); stopping Overwolf, no re-attach this run" >> "$LOG"
                apply_oopo_mode >> "$LOG" 2>&1
                stop_overwolf
                notify_fail "Overwolf loaded a games list without the Linux fix, so it could not read this game session. Overwolf was stopped so the game stays smooth. The fix is re-applied: quit Warframe and start it again with 'alecaframe warframe'."
                gave_up=1
            elif gep_loaded && inventory_ready; then
                if [ "$cap_logged" -eq 0 ]; then
                    sl=$(since_login)
                    echo "$(date +%H:%M:%S) inventory captured (game up ${age}s, $( [ "$sl" -ge 0 ] && echo "${sl}s after login" || echo "login not seen in EE.log"))" >> "$LOG"
                    cap_logged=1
                fi
                # inventory captured: safe to free input by killing the overlay (the data was cached and persists)...
                # but only OVERLAY_KILL_MAX times per scanner session. Overwolf relaunches the overlay after each kill and
                # on 2026-10-27 the third kill in 5 s made it log the live game as "Quit" (feed closed, client spinning).
                if [ "$OVERLAY_KILL_WHEN_LOADED" = "1" ]; then
                    [ "$kill_sess" != "$scan_t0" ] && { kills=0; kill_sess=$scan_t0; }
                    if [ "$kills" -lt "${OVERLAY_KILL_MAX:-1}" ]; then kill_overlays && kills=$((kills+1)); fi
                fi
            elif ! inventory_ready && [ "$scanning" -ge "$GIVEUP_AFTER" ] && { [ "$reattached" -eq 1 ] || gep_loaded; } \
                 && sl=$(since_login) && [ "$sl" -ge "$GIVEUP_AFTER" ]; then
                # still nothing captured this long after LOGIN: stop holding the overlay (input grab, CPU) and stop
                # trying. AlecaFrame keeps the last cached data. Before login (sl=-1) the overlay is always kept: on
                # 2026-11-05 the old game-start clock killed it 97 s before a slow login, so nothing could be captured.
                echo "$(date +%H:%M:%S) no inventory ${sl}s after login (${scanning}s of scanning, game up ${age}s); giving up for this run" >> "$LOG"
                kill_overlays "giving up: no inventory captured"
                notify_fail "AlecaFrame did not get your inventory in the ${GIVEUP_AFTER} s after login. The overlay was stopped so your controls stay free; the game was left alone. It retries next time you start Warframe."
                gave_up=1
            elif gep_loaded; then
                :   # attached but the inventory is not captured yet -> keep the overlay alive so the scan can finish
                    # (up to GIVEUP_AFTER). Killing it early is what made Overwolf drop the game before capture.
            elif [ "$reattached" -eq 0 ] && ! inventory_ready && [ "$age" -ge "$REATTACH_AFTER" ] && overwolf_running; then
                # watchdog: the provider missed the game (idle shutdown, or the first injection timed out during the
                # game's startup). One clean restart of Overwolf+AlecaFrame attaches to the live game.
                echo "$(date +%H:%M:%S) scanner not attached after ${age}s of game time; re-attaching Overwolf (once per run)" >> "$LOG"
                reattached=1
                do_reattach >> "$LOG" 2>&1
            fi
        fi
        if ! overwolf_running; then misses=$((misses+1)); [ "$misses" -ge 10 ] && break; else misses=0; fi
        sleep 1
    done
    rm -f "$REAPER_PIDFILE"
}
start_overlay_reaper() {
    reaper_alive && return 0
    setsid "$0" reap </dev/null >>"$LOG" 2>&1 &
    echo "  (overlay containment armed)"
}
stop_overlay_reaper() {
    if [ -f "$REAPER_PIDFILE" ]; then kill -TERM "$(cat "$REAPER_PIDFILE" 2>/dev/null)" 2>/dev/null; rm -f "$REAPER_PIDFILE"; fi
}
stop_overwolf() {
    local PIDS
    PIDS=$(ps -eo pid,comm 2>/dev/null | awk '$2 ~ /^Overwolf|^ow-overlay|^OWUninst/ {print $1}' | tr '\n' ' ')
    [ -n "$PIDS" ] && { kill -TERM $PIDS 2>/dev/null; sleep 4; }
    PIDS=$(ps -eo pid,comm 2>/dev/null | awk '$2 ~ /^Overwolf|^ow-overlay/ {print $1}' | tr '\n' ' ')
    [ -n "$PIDS" ] && { kill -KILL $PIDS 2>/dev/null; sleep 2; }
}

wait_for_init() {
    local secs="${1:-120}" i=0
    while [ "$i" -lt "$secs" ]; do
        grep -q "Plugin initialization successful" "$AF_BGLOG" 2>/dev/null && return 0
        i=$((i+1)); sleep 1
    done
    return 1
}

do_reattach() {   # restart ONLY Overwolf+AlecaFrame while the game keeps running
    local i t0
    echo "Re-attaching: restarting Overwolf + AlecaFrame (the game is left alone)..."
    stop_overwolf
    # the list may have been refreshed since prepare; Overwolf reads it at startup, so patch it now, between stop and start
    apply_oopo_mode; ensure_manifest_patches
    if game_running && ! oopo_ok; then
        echo "NOT re-attaching: could not set OOPO for Warframe in $(newest_gameslist). Injecting into the running game"
        echo "without it runs the overlay inside the game (stutter, frozen input) and can crash it. Quit the game, then"
        echo "'alecaframe warframe'."
        return 1
    fi
    ensure_data_cache
    : > "$AF_BGLOG" 2>/dev/null || true
    : > "$GEP_LOG" 2>/dev/null || true    # Overwolf is stopped: drop the previous provider session so nothing reads it as "LOADED"
    wait_for_container 600 || return 1
    t0=$(date +%s)
    local pv0 retried=0; pv0=$(pv_errors)
    adopt_overwolf; inject "$OW_LAUNCHER" -launchapp "$AF_EXTID"
    i=0
    while [ "$i" -lt 180 ]; do
        gep_loaded && { echo "Data scanner: LOADED after ${i}s."; return 0; }
        if [ "$retried" -eq 0 ] && [ "$(pv_errors)" -gt "$pv0" ]; then
            retried=1; echo "  (the inject ran into umu's runtime update; waiting for it, then launching once more)"
            wait_for_container 600 || return 1
            pv0=$(pv_errors); t0=$(date +%s); i=0; adopt_overwolf; inject "$OW_LAUNCHER" -launchapp "$AF_EXTID"; continue
        fi
        if [ "$OOPO_MODE" = "on" ] && [ "$(gep_session_start)" -ge "$t0" ] && gep_oopo_off; then
            echo "Provider started WITHOUT OOPO (oopOverlay=false); the scanner cannot attach this run. See: alecaframe doctor"
            return 1
        fi
        i=$((i+5)); sleep 5
    done
    echo "Data scanner still not attached after 180s. Check: alecaframe logs"
    return 1
}

do_prepare() {
    need_profile
    if overwolf_running && ! game_running; then
        echo "Overwolf/AlecaFrame already running. For a clean start: alecaframe stop, then alecaframe prepare."
        return 0
    fi
    if ! launcher_container_up && ! game_running; then
        echo "The Warframe LAUNCHER is not running yet. Order: 'alecaframe warframe' -> wait for READY -> press Play."
        return 1
    fi
    if game_running; then
        echo "Warframe.x64.exe is already running: re-attaching instead (provider attaches to the live game)."
        do_reattach; local rc=$?
        start_overlay_reaper
        return $rc
    fi
    echo "Preparing Overwolf + AlecaFrame in the launcher's container..."
    apply_oopo_mode
    ensure_overlay_on
    check_overlay_not_remotely_disabled
    ensure_manifest_patches
    ensure_data_cache
    : > "$AF_BGLOG" 2>/dev/null || true
    wait_for_container 600 || return 1
    echo "Starting Overwolf + AlecaFrame (single launch)..."
    local i=0 ow_up=0 pv0 retried=0; pv0=$(pv_errors)
    adopt_overwolf; inject "$OW_LAUNCHER" -launchapp "$AF_EXTID"
    while [ "$i" -lt 90 ]; do
        overwolf_running && { ow_up=1; break; }
        if [ "$retried" -eq 0 ] && [ "$(pv_errors)" -gt "$pv0" ]; then
            # the inject landed while umu was still replacing its runtime (first launch after a runtime release)
            retried=1; echo "  (the inject ran into umu's runtime update; waiting for it, then launching once more)"
            wait_for_container 600 || return 1
            pv0=$(pv_errors); i=0; adopt_overwolf; inject "$OW_LAUNCHER" -launchapp "$AF_EXTID"; continue
        fi
        i=$((i+1)); sleep 1
    done
    [ "$ow_up" -eq 1 ] || { echo "Overwolf did not start. See $LOG"; return 1; }
    start_overlay_reaper
    echo "Waiting for AlecaFrame to start..."
    local j=0 af_started=0
    while [ "$j" -lt 60 ]; do
        if grep -qE 'Plugin (early )?initialization (started|completed)|Starting plugin initialization|Plugin instantiated|Checking local data MD5|Plugin initialization successful' "$AF_BGLOG" 2>/dev/null; then af_started=1; break; fi
        if [ "$j" -eq 30 ]; then echo "  (slow start; re-issuing the launch once)"; inject "$OW_LAUNCHER" -launchapp "$AF_EXTID"; fi
        j=$((j+1)); sleep 1
    done
    [ "$af_started" -eq 1 ] || { echo "AlecaFrame did not start. Try: alecaframe stop, then alecaframe prepare."; return 1; }
    echo "Waiting for AlecaFrame to finish initializing (up to 120s)..."
    if wait_for_init 120; then
        if ! oopo_ok; then
            # Overwolf fetched a newer games list while starting, replacing the patched one. It has already loaded
            # that list, so patch it and restart Overwolf once, while the game is not running yet.
            echo "  (Overwolf downloaded a new games list ($(basename "$(newest_gameslist)")) without OOPO; patching it and restarting Overwolf...)"
            stop_overlay_reaper; stop_overwolf
            apply_oopo_mode
            : > "$AF_BGLOG" 2>/dev/null || true
            adopt_overwolf; inject "$OW_LAUNCHER" -launchapp "$AF_EXTID"
            i=0; while [ "$i" -lt 90 ]; do overwolf_running && break; i=$((i+1)); sleep 1; done
            start_overlay_reaper
            if ! wait_for_init 120 || ! oopo_ok; then
                echo "FAILED: Overwolf's games list still has no OOPO for Warframe ($(newest_gameslist))."
                echo "Do not press Play with AlecaFrame now (the overlay would run inside the game). Run: alecaframe stop; alecaframe doctor"
                notify_fail "Setup failed: Overwolf's games list could not be patched. Do not press Play with AlecaFrame; run 'alecaframe doctor'."
                return 1
            fi
        fi
        echo; echo "============================================================"
        echo " READY - AlecaFrame initialized. Press PLAY in the Warframe launcher now"
        echo " (soon: Overwolf's events provider idles out ~20 s after it starts; the"
        echo " watchdog re-attaches automatically if that happens)."
        echo " After the game is up, confirm the data feed with:  alecaframe check-data"
        echo "============================================================"
        notify_ready
        return 0
    fi
    echo "AlecaFrame did not report 'initialization successful' in time. Check: tail -n 40 \"$AF_BGLOG\""
    return 1
}

notify_ready() {   # desktop toast, so a one-click launcher does not need a visible terminal to tell you when to press Play
    command -v notify-send >/dev/null || return 0
    local icon="${XDG_CONFIG_HOME:-$HOME/.config}/alecaframe-linux/warframe.png"
    [ -f "$icon" ] || icon=input-gaming
    notify-send -a AlecaFrame -i "$icon" "AlecaFrame ready" "Press PLAY in the Warframe launcher, then log in." 2>/dev/null || true
}
notify_fail() {   # desktop toast when live data cannot work this run (the game itself is always left alone)
    command -v notify-send >/dev/null || return 0
    local icon="${XDG_CONFIG_HOME:-$HOME/.config}/alecaframe-linux/warframe.png"
    [ -f "$icon" ] || icon=input-gaming
    notify-send -a AlecaFrame -u critical -i "$icon" "AlecaFrame: no live data" "$1" 2>/dev/null || true
}
install_launcher() {   # an app-menu entry "Warframe + AlecaFrame" that runs this tool's `warframe` command
    local self app icon src
    self="$(command -v "$0" 2>/dev/null)"; [ -x "$self" ] || self="$(readlink -f "$0")"
    app="${XDG_DATA_HOME:-$HOME/.local/share}/applications"; mkdir -p "$app"
    icon="${XDG_CONFIG_HOME:-$HOME/.config}/alecaframe-linux/warframe.png"
    src="$WINEPREFIX/drive_c/users/steamuser/AppData/Local/Overwolf/DockIconsCache/DockIcon_8954_64_Normal.png"
    [ -f "$src" ] && cp -f "$src" "$icon" 2>/dev/null
    [ -f "$icon" ] || icon=input-gaming
    cat > "$app/alecaframe-warframe.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Warframe + AlecaFrame
GenericName=Warframe with AlecaFrame
Comment=Launch Warframe with AlecaFrame (Overwolf) attached
Exec=$self warframe
Icon=$icon
Terminal=false
StartupNotify=true
Categories=Game;
EOF
    chmod +x "$app/alecaframe-warframe.desktop" 2>/dev/null
    command -v update-desktop-database >/dev/null && update-desktop-database "$app" 2>/dev/null || true
    echo "  installed: $app/alecaframe-warframe.desktop"
    echo "  Launch \"Warframe + AlecaFrame\" from your app menu (right-click it there to pin it to the taskbar)."
}

case "${1:-}" in
    warframe)
        need_profile; shift
        ensure_x11_driver_keys
        if [ -z "${NO_ALECA:-}" ]; then setsid "$0" wait-prepare >"$LOGDIR/autostart.log" 2>&1 & echo "[alecaframe] auto-prepare running in the background: tail -f $LOGDIR/autostart.log"; fi
        if [ "$INJECT_MODE" = "steam" ]; then exec xdg-open "steam://rungameid/$STEAM_APPID"; fi
        exec env "${UMU_ENV[@]}" umu-run "$(resolve_launcher)" "$@"
        ;;
    reap)
        echo $$ > "$REAPER_PIDFILE"; overlay_reaper_loop; exit 0 ;;
    stop)
        echo "Stopping Overwolf/AlecaFrame (the game is left alone)..."
        stop_overlay_reaper; stop_overwolf; stop_clipkeep; echo "  done" ;;
    check-data)
        overwolf_running || { echo "Overwolf is not running; start via 'alecaframe warframe' first."; exit 1; }
        if gep_loaded; then echo "Data scanner: LOADED (AlecaFrame is getting live game data)."; exit 0; fi
        if [ "$OOPO_MODE" = "on" ] && gep_oopo_off; then
            echo "Data scanner: CANNOT load this run: the provider sees the game without OOPO (Overwolf refreshed its games list)."
            echo "Quit the game, then: alecaframe stop; alecaframe warframe   (the list is re-patched on start)"; exit 1
        fi
        oopo_ok || echo "WARNING: Overwolf's newest games list has no OOPO for Warframe; 'alecaframe prepare' re-patches it."
        echo "Data scanner: NOT loaded yet. It loads after the overlay renders its first in-game frame, so the GAME must be running."
        echo "If the game has been running for a while: alecaframe reattach"; exit 1 ;;
    recover|unfreeze)
        kill_overlays; contain_overlay_windows; reap_dead_overlays; start_overlay_reaper
        echo "Overlay process killed and containment armed. If the game is still frozen, wait 5 s and run it again." ;;
    reattach)
        need_profile; do_reattach; start_overlay_reaper ;;
    install-launcher)
        need_profile; install_launcher ;;
    status)
        launcher_container_up && echo "Warframe launcher: RUNNING" || echo "Warframe launcher: not running"
        game_running && echo "Warframe game:     RUNNING (Warframe.x64.exe, up $(game_age)s)" || echo "Warframe game:     not running"
        overwolf_running && echo "Overwolf:          RUNNING" || echo "Overwolf:          not running"
        if overwolf_running; then gep_loaded && echo "Data scanner:      LOADED" || echo "Data scanner:      not loaded (yet)"; fi
        p=$(ow_client_pid); [ -n "$p" ] && echo "Overwolf memory:   $(( $(ps -o rss= -p "$p" 2>/dev/null || echo 0) / 1024 )) MB resident (self-restarts at 900 MiB), $(ls /proc/"$p"/task 2>/dev/null | wc -l) threads, cgroup $(cut -d: -f3 /proc/"$p"/cgroup 2>/dev/null | sed 's#.*/##')"
        [ -n "$p" ] && { c=$(ow_client_cpu); echo "Overwolf CPU:      ${c}% average since start$( [ "${c%%.*}" -ge 40 ] 2>/dev/null && echo ' (SPINNING: healthy idle is <10%; alecaframe stop)')"; }
        ow_thinks_game_quit && echo "Overwolf state:    thinks the game QUIT while it is running -> live data is over for this run (overlay-kill misdetect; see OVERLAY_KILL_MAX)"
        reaper_alive && echo "Overlay containment: ARMED"
        echo "Profile: $CONF"; echo "  WINEPREFIX=$WINEPREFIX"; echo "  PROTONPATH=$PROTONPATH"; echo "  LAUNCHER=$(resolve_launcher)"
        echo "ptrace_scope: $(cat /proc/sys/kernel/yama/ptrace_scope 2>/dev/null || echo n/a)" ;;
    wait-prepare)
        if overwolf_running && ! grep -q 'Plugin initialization successful' "$AF_BGLOG" 2>/dev/null; then
            echo "[alecaframe] stale Overwolf detected; stopping it first." >&2; stop_overwolf
        fi
        i=0
        while [ "$i" -lt 180 ]; do
            game_running && { echo "[alecaframe] game already running; re-attaching." >&2; do_prepare; exit $?; }
            if launcher_container_up; then
                # umu-run is up, but its container may still be minutes away (runtime download/update on first launch)
                wait_for_container 600 || { echo "[alecaframe] giving up: the launcher's container never became ready. Try: alecaframe prepare" >&2; exit 1; }
                sleep 3; do_prepare; exit $?
            fi
            i=$((i+1)); sleep 1
        done
        exit 0 ;;
    prepare|"")
        do_prepare ;;
    logs)
        echo "--- Overwolf trace"; T=$(ls -t "$OW_APPDATA"/Log/Trace_*.log 2>/dev/null | head -1); [ -n "$T" ] && tr -d '\r' < "$T" | tail -n 15 | cut -c1-200
        echo "--- AlecaFrame background"; [ -f "$AF_BGLOG" ] && grep -v 'Failed to get player username' "$AF_BGLOG" | tail -n 15 | cut -c1-200
        echo "--- events provider"; [ -f "$GEP_LOG" ] && tail -n 10 "$GEP_LOG" | cut -c1-200
        echo "--- launcher/containment"; tail -n 10 "$LOG" 2>/dev/null ;;
    profile)
        echo "config file: $CONF"; for v in WINEPREFIX GAME_DIR LAUNCHER_EXE GAMEID STORE PROTONPATH AF_EXTID OOPO_MODE NEUTER_REMOTE_DISABLE OVERLAY_KILL_WHEN_LOADED OVERLAY_KILL_MAX REATTACH_AFTER GIVEUP_AFTER TRIM_MEMORY TRIM_ABOVE_MB TRIM_TO_MB INJECT_MODE STEAM_APPID SLR_LAUNCH_CLIENT; do echo "$v=${!v}"; done
        echo "launcher resolves to: $(resolve_launcher)" ;;
    doctor)
        ok() { echo "  [ok]   $*"; }; bad() { echo "  [!!]   $*"; }
        command -v umu-run >/dev/null && ok "umu-run $(umu-run --version 2>/dev/null | head -1)" || bad "umu-run not found (install umu-launcher)"
        if [ -f "$UMU_LOCAL/$UMU_RUNTIME/VERSIONS.txt" ]; then
            if flock -n "$UMU_LOCAL/umu.lock" true 2>/dev/null; then ok "umu runtime $UMU_RUNTIME $(awk -F'\t' '$1=="depot"{print $2}' "$UMU_LOCAL/$UMU_RUNTIME/VERSIONS.txt") (not updating)"
            else bad "umu is updating its runtime $UMU_RUNTIME right now; 'alecaframe prepare' waits for it (up to 10 min)"; fi
        else bad "umu runtime $UMU_RUNTIME not installed yet under $UMU_LOCAL (the first 'alecaframe warframe' downloads it; prepare waits)"; fi
        for t in python3 curl xdotool wmctrl; do command -v $t >/dev/null && ok "$t" || bad "$t missing$( [ "$t" = xdotool ] || [ "$t" = wmctrl ] && echo ' (optional: overlay window containment)')"; done
        ps=$(cat /proc/sys/kernel/yama/ptrace_scope 2>/dev/null || echo "?")
        if [ "$ps" = "0" ]; then ok "kernel.yama.ptrace_scope=0 (Wine's ReadProcessMemory between sibling processes works)"; else bad "kernel.yama.ptrace_scope=$ps: the data scanner may read nothing. Fedora/Nobara ship 0; Ubuntu/Arch ship 1. To change (needs root): sudo sysctl kernel.yama.ptrace_scope=0 (persist in /etc/sysctl.d/). This lowers a system-wide hardening knob; see README."; fi
        [ -n "$WINEPREFIX" ] && [ -d "$WINEPREFIX/drive_c" ] && ok "prefix $WINEPREFIX" || bad "prefix missing"
        [ -d "$HOME/.local/share/Steam/compatibilitytools.d/$PROTONPATH" ] && ok "Proton $PROTONPATH" || bad "Proton $PROTONPATH not in ~/.local/share/Steam/compatibilitytools.d"
        [ -f "$OW_LAUNCHER" ] && ok "Overwolf installed" || bad "Overwolf not installed in the prefix"
        grep -q '"Release"=dword:00080' "$WINEPREFIX/system.reg" 2>/dev/null && ok ".NET Framework 4.8 in prefix" || bad ".NET Framework 4.8 missing in prefix"
        [ -d "$OW_APPDATA/Extensions/$AF_EXTID" ] && ok "AlecaFrame installed ($(ls "$OW_APPDATA/Extensions/$AF_EXTID" | tail -1))" || bad "AlecaFrame not installed in Overwolf"
        if [ "$OOPO_MODE" = "on" ]; then
            gl=$(newest_gameslist)
            if [ -z "$gl" ]; then ok "no downloaded games list yet (Overwolf uses its bundled one)"
            elif oopo_present_in "$gl"; then ok "OOPO set for Warframe in $(basename "$gl")"
            else bad "OOPO missing for Warframe in $(basename "$gl") (Overwolf refreshed its games list; 'alecaframe prepare' re-patches it)"; fi
            gep_oopo_off && bad "last provider session ran WITHOUT OOPO (oopOverlay=false): no live data that run"
        fi
        [ -f "$(resolve_launcher)" ] && ok "launcher: $(resolve_launcher)" || bad "launcher not found: $(resolve_launcher)"
        [ -d "$GAME_DIR/Public" ] && ok "game content: $GAME_DIR/Public" || bad "game content dir missing: $GAME_DIR/Public"
        if [ "$TRIM_MEMORY" = "1" ]; then
            ucg="/sys/fs/cgroup/user.slice/user-$(id -u).slice/user@$(id -u).service"
            if ! command -v busctl >/dev/null; then bad "busctl missing: Overwolf memory trim disabled (it may restart itself at 900 MiB)"
            elif ! grep -qw memory "$ucg/cgroup.controllers" 2>/dev/null; then bad "memory cgroup controller not delegated to your user session: Overwolf memory trim disabled"
            elif [ ! -e "$ucg/app.slice/memory.reclaim" ]; then bad "no memory.reclaim in your user session's cgroups (needs Linux 5.19+): Overwolf memory trim disabled"
            else ok "Overwolf memory trim available (user scope + memory.reclaim)"; fi
            [ "$(awk 'NR>1' /proc/swaps | wc -l)" -gt 0 ] && ok "swap present (trimmed Overwolf pages need somewhere to go)" || bad "no swap: the memory trim can only drop file pages"
        fi ;;
    install-kwin-rules)
        command -v kwriteconfig6 >/dev/null || { echo "kwriteconfig6 not found (KDE Plasma 6 only)"; exit 1; }
        RC="$HOME/.config/kwinrulesrc"
        add_rule() {
            local id="$1" title="$2"; shift 2
            kwriteconfig6 --file "$RC" --group "$id" --key Description "AlecaFrame: $title"
            kwriteconfig6 --file "$RC" --group "$id" --key title "$title"
            kwriteconfig6 --file "$RC" --group "$id" --key titlematch 1
            kwriteconfig6 --file "$RC" --group "$id" --key wmclass "steam_app"
            kwriteconfig6 --file "$RC" --group "$id" --key wmclassmatch 2
            while [ $# -gt 0 ]; do kwriteconfig6 --file "$RC" --group "$id" --key "${1%%=*}" "${1#*=}"; shift; done
        }
        add_rule aleca-ow-overlay "ow overlay" below=true belowrule=2 skiptaskbar=true skiptaskbarrule=2 skipswitcher=true skipswitcherrule=2 skippager=true skippagerrule=2 acceptfocus=false acceptfocusrule=2 minimize=true minimizerule=3
        add_rule aleca-ow-quick "Overwolf Quick Launcher" skiptaskbar=true skiptaskbarrule=2 minimize=true minimizerule=3
        cur=$(kreadconfig6 --file "$RC" --group General --key rules)
        new="$cur"; for id in aleca-ow-overlay aleca-ow-quick; do case ",$new," in *",$id,"*) ;; *) new="${new:+$new,}$id";; esac; done
        kwriteconfig6 --file "$RC" --group General --key rules "$new"
        qdbus org.kde.KWin /KWin reconfigure >/dev/null 2>&1 || qdbus-qt6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1
        echo "KWin rules installed: $new" ;;
    *)
        echo "Usage: alecaframe warframe | prepare | reattach | unfreeze | stop | status | check-data | logs | profile | doctor | install-kwin-rules | install-launcher"; exit 2 ;;
esac
