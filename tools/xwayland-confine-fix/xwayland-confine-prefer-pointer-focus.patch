+/* TRUE when the InputOutput toplevel of xwl_window covers window's geometry */
+static Bool
+xwl_window_covers_window(struct xwl_window *xwl_window, WindowPtr window)
+{
+    WindowPtr toplevel = xwl_window->toplevel;
+
+    if (toplevel->drawable.class == InputOnly)
+        return FALSE;
+
+    return window->drawable.x >= toplevel->drawable.x &&
+           window->drawable.x + window->drawable.width <=
+           toplevel->drawable.x + toplevel->drawable.width &&
+           window->drawable.y >= toplevel->drawable.y &&
+           window->drawable.y + window->drawable.height <=
+           toplevel->drawable.y + toplevel->drawable.height;
+}
