         else
+        {
             status = fixup_imports( wm, NULL );
+            if (!status && (wm->ldr.Flags & LDR_COR_IMAGE) &&
+                !RtlImageNtHeader( wm->ldr.DllBase )->OptionalHeader.AddressOfEntryPoint)
+                status = fixup_cor_entry( wm, NULL, entry );
+        }
 
